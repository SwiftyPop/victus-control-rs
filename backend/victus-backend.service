[Unit]
Description=Victus Control Backend System Service
After=systemd-modules-load.service victus-healthcheck.service network.target dbus.service
Wants=victus-healthcheck.service


[Service]
ExecStart=/usr/bin/victus-backend
Restart=always
RestartSec=5
User=root
Group=root

[Install]
WantedBy=multi-user.target
