[Unit]
Description=Victus Control temperature monitor (desktop notifications)
Documentation=https://github.com/SwiftyPop/victus-control-rs

# Only meaningful inside a graphical session where notifications can be shown.
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/victus-monitor
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
